{
  "name": "ha-network-panel",
  "version": "1.0.2",
  "description": "Home Assistant sidebar panel for the home network: internet box, routers, switches, Wi-Fi, devices, DNS filter, speed tests and reverse proxy.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "check": "node scripts/build-frontend.mjs && node --check custom_components/network_panel/frontend/network-panel.js",
    "prescreenshots": "node scripts/build-frontend.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "pretest": "node scripts/build-frontend.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.19.0",
    "playwright": "^1.65.1"
  }
}
